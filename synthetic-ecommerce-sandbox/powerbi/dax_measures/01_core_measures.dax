// ============================================================
// POWER BI DAX MEASURES
// File: 01_core_measures.dax
// Dashboard: All dashboards (shared measures)
// ============================================================
//
// HOW TO USE:
// 1. In Power BI Desktop, go to Model view
// 2. Select the table where you want to add measures (e.g., fact_sales)
// 3. Click "New Measure" in the ribbon
// 4. Paste each measure below
// ============================================================


// ============================================================
// SECTION 1: BASIC REVENUE MEASURES
// ============================================================

// Total Gross Revenue
Total Gross Revenue =
SUMX(
    fact_sales,
    fact_sales[quantity] * fact_sales[unit_price]
)

// Total Net Revenue (after item and order discounts)
Total Net Revenue =
SUMX(
    fact_sales,
    (fact_sales[quantity] * fact_sales[unit_price] * (1 - fact_sales[item_discount_pct] / 100))
        - fact_sales[order_discount_amount]
)

// Total Orders
Total Orders =
DISTINCTCOUNT(fact_sales[order_id])

// Total Units Sold
Total Units Sold =
SUM(fact_sales[quantity])

// Total Customers
Total Customers =
DISTINCTCOUNT(fact_sales[customer_id])

// Average Order Value (AOV)
Average Order Value =
DIVIDE(
    [Total Net Revenue],
    [Total Orders],
    0
)

// Average Revenue Per Customer
Avg Revenue Per Customer =
DIVIDE(
    [Total Net Revenue],
    [Total Customers],
    0
)


// ============================================================
// SECTION 2: PROFIT MEASURES
// ============================================================

// Total Gross Profit
Total Gross Profit =
SUMX(
    fact_sales,
    fact_sales[net_profit]
)

// Gross Profit Margin %
Gross Profit Margin % =
DIVIDE(
    [Total Gross Profit],
    [Total Net Revenue],
    0
) * 100

// Total Shipping Revenue
Total Shipping Revenue =
SUMX(
    DISTINCT(fact_sales[order_id]),
    LOOKUPVALUE(
        fact_sales[shipping_fee],
        fact_sales[order_id], fact_sales[order_id]
    )
)

// Total Discount Given
Total Discount Given =
SUMX(
    fact_sales,
    (fact_sales[quantity] * fact_sales[unit_price] * fact_sales[item_discount_pct] / 100)
) + SUM(fact_sales[order_discount_amount])


// ============================================================
// SECTION 3: TIME INTELLIGENCE MEASURES
// ============================================================

// Revenue - Previous Month
Revenue PM =
CALCULATE(
    [Total Net Revenue],
    PREVIOUSMONTH('dim_date'[date])
)

// Month-over-Month Revenue Growth
MoM Revenue Growth =
VAR CurrentMonthRevenue = [Total Net Revenue]
VAR PrevMonthRevenue    = [Revenue PM]
RETURN
DIVIDE(
    CurrentMonthRevenue - PrevMonthRevenue,
    PrevMonthRevenue,
    BLANK()
)

// MoM Growth % (formatted)
MoM Revenue Growth % =
[MoM Revenue Growth] * 100

// Revenue - Same Period Last Year (YoY)
Revenue SPLY =
CALCULATE(
    [Total Net Revenue],
    SAMEPERIODLASTYEAR('dim_date'[date])
)

// Year-over-Year Revenue Growth %
YoY Revenue Growth % =
DIVIDE(
    [Total Net Revenue] - [Revenue SPLY],
    [Revenue SPLY],
    BLANK()
) * 100

// Revenue YTD
Revenue YTD =
TOTALYTD(
    [Total Net Revenue],
    'dim_date'[date]
)

// Revenue - Previous Year YTD
Revenue Prev Year YTD =
CALCULATE(
    [Revenue YTD],
    SAMEPERIODLASTYEAR('dim_date'[date])
)

// Revenue QTD
Revenue QTD =
TOTALQTD(
    [Total Net Revenue],
    'dim_date'[date]
)

// Revenue MTD
Revenue MTD =
TOTALMTD(
    [Total Net Revenue],
    'dim_date'[date]
)

// 3-Month Rolling Average Revenue
Rolling 3M Revenue Avg =
AVERAGEX(
    DATESINPERIOD(
        'dim_date'[date],
        LASTDATE('dim_date'[date]),
        -3,
        MONTH
    ),
    [Total Net Revenue]
)

// 12-Month Trailing Revenue
Trailing 12M Revenue =
CALCULATE(
    [Total Net Revenue],
    DATESINPERIOD(
        'dim_date'[date],
        LASTDATE('dim_date'[date]),
        -12,
        MONTH
    )
)


// ============================================================
// SECTION 4: ORDER & CUSTOMER KPI MEASURES
// ============================================================

// Total Orders - Previous Month
Orders PM =
CALCULATE(
    [Total Orders],
    PREVIOUSMONTH('dim_date'[date])
)

// MoM Order Growth %
MoM Orders Growth % =
DIVIDE(
    [Total Orders] - [Orders PM],
    [Orders PM],
    BLANK()
) * 100

// New Customers This Period
New Customers =
CALCULATE(
    DISTINCTCOUNT(fact_sales[customer_id]),
    FILTER(
        dim_customers,
        MONTH(dim_customers[first_order_date]) = MONTH(MAX('dim_date'[date]))
            && YEAR(dim_customers[first_order_date]) = YEAR(MAX('dim_date'[date]))
    )
)

// Repeat Customer Rate %
Repeat Customer Rate % =
VAR TotalCust   = DISTINCTCOUNT(dim_customers[customer_id])
VAR RepeatCust  =
    CALCULATE(
        DISTINCTCOUNT(dim_customers[customer_id]),
        dim_customers[total_orders] > 1
    )
RETURN
DIVIDE(RepeatCust, TotalCust, 0) * 100

// Customer Acquisition Rate (new customers / total)
Customer Acquisition Rate % =
DIVIDE(
    [New Customers],
    [Total Customers],
    0
) * 100

// Cancellation Rate %
Cancellation Rate % =
VAR AllOrders = CALCULATE(DISTINCTCOUNT(orders[order_id]))
VAR CancelledOrders = CALCULATE(
    DISTINCTCOUNT(orders[order_id]),
    orders[status] = "Cancelled"
)
RETURN
DIVIDE(CancelledOrders, AllOrders, 0) * 100
